import discord
from discord.ext import commands

intents = discord.Intents.all()
bot = commands.Bot(command_prefix='.', intents=intents)

@bot.event
async def on_ready():
    print(f'Bot {bot.user} está pronto e online!')

@bot.command()
async def reciclagem(ctx):
    await ctx.send(
        "**Qual material você deseja reciclar?**\n\n"
        "`.papel`\n"
        "`.plastico`\n"
        "`.vidro`\n"
        "`.metal`\n"
        "`.organico`\n"
        "`.eletronico`"
    )

